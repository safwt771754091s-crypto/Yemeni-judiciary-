# ===========================================================================
# Legal AI Platform (Yemen) - environment configuration
# Copy to .env and fill in real values.  NEVER commit .env.
# ===========================================================================

APP_NAME="Legal AI Platform - Yemen"
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Supabase / PostgreSQL (pgvector) -------------------------------------
# Session-pooler / direct Postgres DSN from Supabase > Project Settings > Database
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional REST credentials (used by n8n / external clients)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings ------------------------------------------------------------
# provider: hash (offline, deterministic) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# --- LLM (strict legal reasoning) -----------------------------------------
# provider: mock (offline, deterministic) | openai | anthropic | openai_compatible
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
# When the hosted model is unreachable (no internet), answer with the offline
# reasoner instead of failing the request. Set false to surface the error.
LLM_OFFLINE_FALLBACK=true

# --- Retrieval / RAG tuning ------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
VECTOR_WEIGHT=0.65
KEYWORD_WEIGHT=0.35
RRF_K=60
MIN_CITATION_SCORE=0.18

# --- Legal domain defaults -------------------------------------------------
JURISDICTION="الجمهورية اليمنية"
DEFAULT_COURT_NAME="المحكمة الابتدائية"
DEFAULT_CASE_TYPE=مدني

# --- n8n integration -------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_HMAC_SECRET=
N8N_ENABLED=false

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=25
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_FILES=10
MAX_CASE_TEXT_CHARS=200000

# --- Document extraction / OCR ---------------------------------------------
# Scanned Yemeni court filings have no text layer, so Arabic OCR is the only
# way to read them. Requires the Tesseract binary with the `ara` language data
# (Debian/Ubuntu: apt-get install -y tesseract-ocr tesseract-ocr-ara).
# Set OCR_ENABLED=false where Tesseract is unavailable; the API then reports
# the limitation instead of failing silently.
OCR_ENABLED=true
OCR_LANGUAGES=ara+eng
OCR_DPI=300
OCR_PSM=6
# A PDF page whose text layer yields fewer characters than this is re-read with
# OCR (typical of scanned filings).
PDF_TEXT_MIN_CHARS=80

# --- Intake / classification ------------------------------------------------
# Below this confidence the intake response flags the case type for human review.
CLASSIFICATION_MIN_CONFIDENCE=0.35
# Whether POST /cases/intake runs the judgment pipeline automatically.
INTAKE_AUTO_JUDGMENT=true

# --- Auth / RBAC -----------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Platform owner account, seeded on first startup when no users exist.
# Change the password immediately after the first login.
OWNER_USERNAME=owner
OWNER_PASSWORD=Owner@Yemen2026
OWNER_FULL_NAME="مالك المنصة"
OWNER_EMAIL=
# Self-service signup (Harvey-style). Set ALLOW_SELF_SIGNUP=false to require
# invitations; signups may only pick a professional portal role, never owner/admin/editor.
ALLOW_SELF_SIGNUP=true
SIGNUP_DEFAULT_ROLE=viewer
# Let users sign in with their email address as well as their username.
ALLOW_EMAIL_LOGIN=true

# --- Account self-service (password reset, email verification, Google) ------
# Public base URL used to build the links inside outgoing mail. Leave empty to
# derive it from the request's own origin.
APP_BASE_URL=
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFY_EXPIRE_MINUTES=1440
# Require a confirmed email before an account can log in. Off by default so the
# platform works with no mail server; turn it on once MAIL_PROVIDER is set.
REQUIRE_EMAIL_VERIFICATION=false

# Mail delivery. "console" logs the message (including the link) instead of
# sending it, which is the default so the platform runs with no mail server.
# Use "smtp" or "resend" for real delivery.
MAIL_PROVIDER=console
MAIL_FROM=no-reply@yemen-legal.local
MAIL_FROM_NAME="المنصة القانونية الذكية"
MAIL_TIMEOUT_SECONDS=10
# SMTP (MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Resend (MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Google sign-in (optional). Set both id and secret to show the "continue with
# Google" button and enable the OAuth callback. Leave empty to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only when the public callback URL differs from <APP_BASE_URL>/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=
