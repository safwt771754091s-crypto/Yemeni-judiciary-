# ===========================================================================
# Legal AI Platform (Yemen) - environment configuration
# Copy to .env and fill in real values.  NEVER commit .env.
# ===========================================================================

APP_NAME="Legal AI Platform - Yemen"
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Supabase / PostgreSQL (pgvector) -------------------------------------
# Session-pooler / direct Postgres DSN from Supabase > Project Settings > Database
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional REST credentials (used by n8n / external clients)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings ------------------------------------------------------------
# provider: hash (offline, deterministic) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# --- LLM (strict legal reasoning) -----------------------------------------
# provider: mock (offline, deterministic) | openai | anthropic | openai_compatible
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# --- Retrieval / RAG tuning ------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
VECTOR_WEIGHT=0.65
KEYWORD_WEIGHT=0.35
RRF_K=60
MIN_CITATION_SCORE=0.18

# --- Legal domain defaults -------------------------------------------------
JURISDICTION=الجمهورية اليمنية
DEFAULT_COURT_NAME=المحكمة الابتدائية
DEFAULT_CASE_TYPE=مدني

# --- n8n integration -------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_HMAC_SECRET=
N8N_ENABLED=false

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=25
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_FILES=10
MAX_CASE_TEXT_CHARS=200000

# --- Document extraction / OCR ---------------------------------------------
# Scanned Yemeni court filings have no text layer, so Arabic OCR is the only
# way to read them. Requires the Tesseract binary with the `ara` language data
# (Debian/Ubuntu: apt-get install -y tesseract-ocr tesseract-ocr-ara).
# Set OCR_ENABLED=false where Tesseract is unavailable; the API then reports
# the limitation instead of failing silently.
OCR_ENABLED=true
OCR_LANGUAGES=ara+eng
OCR_DPI=300
OCR_PSM=6
# A PDF page whose text layer yields fewer characters than this is re-read with
# OCR (typical of scanned filings).
PDF_TEXT_MIN_CHARS=80

# --- Intake / classification ------------------------------------------------
# Below this confidence the intake response flags the case type for human review.
CLASSIFICATION_MIN_CONFIDENCE=0.35
# Whether POST /cases/intake runs the judgment pipeline automatically.
INTAKE_AUTO_JUDGMENT=true

# --- Auth / RBAC -----------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Platform owner account, seeded on first startup when no users exist.
# Change the password immediately after the first login.
OWNER_USERNAME=owner
OWNER_PASSWORD=Owner@Yemen2026
OWNER_FULL_NAME=مالك المنصة
OWNER_EMAIL=
